
@startuml


class GameLluviaMenu {
    - batch: SpriteBatch
    - font: BitmapFont
    - higherScore: int
    + create(): void
    + render(): void
    + dispose(): void
    + getBatch(): SpriteBatch
    + getFont(): BitmapFont
    + getHigherScore(): int
    + setHigherScore(higherScore: int): void
}

interface Screen {
    + render(delta: float): void
    + show(): void
    + resize(width: int, height: int): void
    + pause(): void
    + resume(): void
    + hide(): void
    + dispose(): void
}

class MainMenuScreen {
    - game: GameLluviaMenu
    - batch: SpriteBatch
    - font: BitmapFont
    - camera: OrthographicCamera
    + MainMenuScreen(game: GameLluviaMenu)
    + render(delta: float): void
    + show(): void
    + resize(width: int, height: int): void
    + pause(): void
    + resume(): void
    + hide(): void
    + dispose(): void
}

class GameScreen {
    - game: GameLluviaMenu
    - camera: OrthographicCamera
    - batch: SpriteBatch
    - font: BitmapFont
    - tarro: Tarro
    - lluvia: Lluvia
    + GameScreen(game: GameLluviaMenu)
    + render(delta: float): void
    + resize(width: int, height: int): void
    + show(): void
    + hide(): void
    + pause(): void
    + resume(): void
    + dispose(): void
}

class PausaScreen {
    - game: GameLluviaMenu
    - juego: GameScreen
    - batch: SpriteBatch
    - font: BitmapFont
    - camera: OrthographicCamera
    + PausaScreen(game: GameLluviaMenu, juego: GameScreen)
    + render(delta: float): void
    + show(): void
    + resize(width: int, height: int): void
    + pause(): void
    + resume(): void
    + hide(): void
    + dispose(): void
}

class GameOverScreen {
    - game: GameLluviaMenu
    - batch: SpriteBatch
    - font: BitmapFont
    - camera: OrthographicCamera
    + GameOverScreen(game: GameLluviaMenu)
    + render(delta: float): void
    + show(): void
    + resize(width: int, height: int): void
    + pause(): void
    + resume(): void
    + hide(): void
    + dispose(): void
}

class Tarro {
    - instancia: Tarro
    - bucket: Rectangle
    - bucketImage: Texture
    - sonidoHerido: Sound
    - vidas: int
    - puntos: int
    - velx: int
    - herido: boolean
    - tiempoHeridoMax: int
    - tiempoHerido: int
    - xVisual: float
    - yVisual: float
    - Tarro(tex: Texture, sonido: Sound)
    + getInstance(textura: Texture, sonido: Sound): Tarro
    + getInstance(): Tarro
    + getVidas(): int
    + getPuntos(): int
    + getArea(): Rectangle
    + sumarPuntos(pp: int): void
    + reiniciar(): void
    + dañar(): void
    + dibujar(batch: SpriteBatch): void
    + actualizarMovimiento(): void
    + destruir(): void
    + estaHerido(): boolean
}

class Lluvia {
    - objetosCaidos: Array<ObjetoCaida>
    - lastDropTime: long
    - texMoneda: Texture
    - texBillete: Texture
    - texMano: Texture
    - texChicle: Texture
    - dropSound: Sound
    - rainMusic: Music
    + Lluvia(texMoneda: Texture, texBillete: Texture, texMano: Texture, texChicle: Texture, dropSound: Sound, rainMusic: Music)
    + crear(): void
    - crearObjetoCaida(): void
    + actualizarMovimiento(tarro: Tarro): boolean
    + actualizarDibujoLluvia(batch: SpriteBatch): void
    + destruir(): void
    + pausar(): void
    + continuar(): void
}

class ObjetoBuilder {
    - x: float
    - y: float
    - textura: Texture
    - sonido: Sound
    + setPosicion(x: float, y: float): ObjetoBuilder
    + setTextura(textura: Texture): ObjetoBuilder
    + setSonido(sonido: Sound): ObjetoBuilder
    + buildMoneda(): Moneda
    + buildBillete(): Billete
    + buildMano(): Mano
    + buildChicle(): Chicle
}

abstract class ObjetoCaida {
    # hitbox: Rectangle
    # estrategiaMovimiento: EstrategiaMovimiento
    # destruido: boolean
    + ObjetoCaida(x: float, y: float, estrategia: EstrategiaMovimiento)
    + actualizar(tarro: Tarro, delta: float): void
    + dibujar(batch: SpriteBatch): void
    + estaDestruido(): boolean
    # aplicarEfecto(tarro: Tarro): void
    # getTextura(): Texture
    # reproducirSonido(): void
}

class Moneda {
    - textura: Texture
    - sonido: Sound
    + Moneda(x: float, y: float, textura: Texture, sonido: Sound)
    # aplicarEfecto(tarro: Tarro): void
    # getTextura(): Texture
    # reproducirSonido(): void
}

class Billete {
    - textura: Texture
    - sonido: Sound
    + Billete(x: float, y: float, textura: Texture, sonido: Sound)
    # aplicarEfecto(tarro: Tarro): void
    # getTextura(): Texture
    # reproducirSonido(): void
}

class Mano {
    - textura: Texture
    + Mano(x: float, y: float, textura: Texture)
    # aplicarEfecto(tarro: Tarro): void
    # getTextura(): Texture
    # reproducirSonido(): void
}

class Chicle {
    - textura: Texture
    + Chicle(x: float, y: float, textura: Texture)
    # aplicarEfecto(tarro: Tarro): void
    # getTextura(): Texture
    # reproducirSonido(): void
}

interface EstrategiaMovimiento {
    + mover(hitbox: Rectangle, objetivo: Rectangle, delta: float): void
}

class MovimientoRecto {
    - velocidadY: float
    + mover(hitbox: Rectangle, objetivo: Rectangle, delta: float): void
}

class MovimientoZigZag {
    - velocidadY: float
    - velocidadX: float
    - direccionX: int
    + MovimientoZigZag()
    + mover(hitbox: Rectangle, objetivo: Rectangle, delta: float): void
}

class MovimientoPersecucion {
    - velocidadY: float
    - velocidadX: float
    + mover(hitbox: Rectangle, objetivo: Rectangle, delta: float): void
}

class DesktopLauncher {
    + main(arg: String[]): void
}

Game <|-- GameLluviaMenu

Screen <|.. MainMenuScreen
Screen <|.. GameScreen
Screen <|.. PausaScreen
Screen <|.. GameOverScreen

ObjetoCaida <|-- Moneda
ObjetoCaida <|-- Billete
ObjetoCaida <|-- Mano
ObjetoCaida <|-- Chicle

EstrategiaMovimiento <|.. MovimientoRecto
EstrategiaMovimiento <|.. MovimientoZigZag
EstrategiaMovimiento <|.. MovimientoPersecucion



GameScreen --> GameLluviaMenu
MainMenuScreen --> GameLluviaMenu
PausaScreen --> GameLluviaMenu
PausaScreen --> GameScreen
GameOverScreen --> GameLluviaMenu

GameScreen --> Tarro
GameScreen *-- Lluvia

Lluvia o-- "0..*" ObjetoCaida : objetosCaidos
Lluvia ..> ObjetoBuilder : utiliza

ObjetoBuilder ..> Moneda : crea
ObjetoBuilder ..> Billete : crea
ObjetoBuilder ..> Mano : crea
ObjetoBuilder ..> Chicle : crea

ObjetoCaida --> EstrategiaMovimiento : utiliza
ObjetoCaida --> Tarro : interactua

DesktopLauncher ..> GameLluviaMenu : inicia

@enduml
